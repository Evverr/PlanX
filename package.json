{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "description": "Совместная доска для планирования в духе Miro",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "python3 scripts/gen_icons.py"
  },
  "dependencies": {
    "lib0": "0.2.98",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "ws": "8.18.0",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.6",
    "y-websocket": "2.1.0",
    "yjs": "13.6.20"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
